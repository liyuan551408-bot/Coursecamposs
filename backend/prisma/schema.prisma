generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum CourseSemester {
  SEMESTER_1
  SEMESTER_2
  SUMMER
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  QUIZ
  PROJECT
  LAB
  PRESENTATION
}

enum AssessmentStyle {
  EXAM_HEAVY
  COURSEWORK_HEAVY
  PROJECT_BASED
  PRACTICAL
  BALANCED
}

model User {
  // 基础信息
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  passwordHash        String
  name                String
  role                UserRole @default(STUDENT)
  major               String?
  studyYear           Int?
  interests           String[] @default([])
  goals               String[] @default([])
  planningPreferences Json?

  // 密码重置
  resetCode        String? // 6位邮箱验证码
  resetCodeExpires DateTime? //验证码过期时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews          Review[]
  savedCourses     SavedCourse[]
  semesterPlans    SemesterPlan[]
  completedCourses CompletedCourse[]
}

model Course {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  description      String?
  credits          Int
  workloadHours    Int?
  offeredSemesters CourseSemester[] @default([])
  level            Int?
  assessmentTypes  AssessmentType[] @default([])
  officialLink     String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  embedding Unsupported("vector(512)")?

  // 先决条件
  // 当前课程需要哪些前置课
  prerequisites   Course[] @relation("CoursePrerequisites")
  // 当前课程是哪些其他课的前置课
  prerequisiteFor Course[] @relation("CoursePrerequisites")

  reviews      Review[]
  savedCourses SavedCourse[]
  planCourses  PlanCourse[]
  completedBy  CompletedCourse[]

  @@index([level])
  @@index([name])
  @@index([isActive])
}

model Review {
  id               Int              @id @default(autoincrement())
  userId           Int
  courseId         Int
  overallRating    Int
  difficultyRating Int
  workloadRating   Int
  teachingRating   Int?
  assessmentStyle  AssessmentStyle?
  usefulnessRating Int?
  comment          String?
  status           ReviewStatus     @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId, status])
}

model SavedCourse {
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model CompletedCourse {
  userId      Int
  courseId    Int
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([userId, courseId])
  @@index([courseId])
}

model SemesterPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  year      Int
  semester  String
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCourses PlanCourse[]

  @@unique([userId, year, semester, name])
  @@index([userId, year, semester])
}

model PlanCourse {
  planId   Int
  courseId Int

  plan   SemesterPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id])

  @@id([planId, courseId])
}
